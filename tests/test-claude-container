# Without a token the container starts logged out. That is recoverable, but only if the launcher
# says how, because Claude Code's own message ("OAuth session expired") points at the wrong cause.
function test_missing_claude_oauth_token_warns_with_setup_hint() {
  local case_home="${TEST_ROOT}/oauth-missing-home"
  local run_args="${case_home}/run-args"
  local stderr_file="${case_home}/stderr"

  mkdir -p "${case_home}"

  ( cd "${case_home}" && env -i \
    PATH="${STUB_PATH}:${ORIGINAL_PATH}" \
    HOME="${case_home}" \
    TEST_DOCKER_RUN_ARGS_FILE="${run_args}" \
    "${BIN_ROOT}/claude-container" 2>"${stderr_file}" )

  grep --fixed-strings --quiet -- 'claude setup-token' "${stderr_file}" || \
    fail "the missing-token warning omits the command that mints a container credential"
  grep --fixed-strings --quiet -- 'add-generic-password' "${stderr_file}" || \
    fail "the missing-token warning omits how to store the credential for reuse"
  if grep --fixed-strings --line-regexp --quiet -- 'CLAUDE_CODE_OAUTH_TOKEN' "${run_args}"; then
    fail "an empty CLAUDE_CODE_OAUTH_TOKEN is forwarded to docker"
  fi
}

# A setup-token credential cannot establish Remote Control sessions, and it outranks the on-disk
# credential, so forwarding it once the container has been signed in with `claude auth login`
# would silently take Remote Control away again.
function test_full_scope_credential_suppresses_the_oauth_token() {
  local case_home="${TEST_ROOT}/oauth-full-scope-home"
  local run_args="${case_home}/run-args"

  mkdir -p "${case_home}/.claude"
  print -r -- '{"claudeAiOauth":{"accessToken":"full-scope-token","refreshToken":"r"}}' \
    >"${case_home}/.claude/.credentials.json"

  ( cd "${case_home}" && env -i \
    PATH="${STUB_PATH}:${ORIGINAL_PATH}" \
    HOME="${case_home}" \
    TEST_KEYCHAIN_CLAUDE_CODE_OAUTH_TOKEN="test-oauth-should-be-ignored" \
    TEST_DOCKER_RUN_ARGS_FILE="${run_args}" \
    "${BIN_ROOT}/claude-container" )

  if grep --fixed-strings --line-regexp --quiet -- 'CLAUDE_CODE_OAUTH_TOKEN' "${run_args}"; then
    fail "the setup-token is forwarded even though a full-scope credential is present"
  fi
  grep --fixed-strings --quiet -- "${case_home}/.claude:/home/pde/.claude:rw" "${run_args}" || \
    fail "~/.claude is not mounted, so the full-scope credential cannot reach the container"
}

# The host's own credentials file is a stub with empty tokens, which must not be mistaken for a
# usable login: that stub is the reason a container starts logged out in the first place.
function test_empty_token_stub_does_not_suppress_the_oauth_token() {
  local case_home="${TEST_ROOT}/oauth-stub-home"
  local run_args="${case_home}/run-args"

  mkdir -p "${case_home}/.claude"
  print -r -- '{"claudeAiOauth":{"accessToken":"","refreshToken":"","expiresAt":0}}' \
    >"${case_home}/.claude/.credentials.json"

  ( cd "${case_home}" && env -i \
    PATH="${STUB_PATH}:${ORIGINAL_PATH}" \
    HOME="${case_home}" \
    TEST_KEYCHAIN_CLAUDE_CODE_OAUTH_TOKEN="test-oauth-stub-fallback" \
    TEST_DOCKER_RUN_ARGS_FILE="${run_args}" \
    "${BIN_ROOT}/claude-container" )

  grep --fixed-strings --line-regexp --quiet -- 'CLAUDE_CODE_OAUTH_TOKEN' "${run_args}" || \
    fail "the empty-token stub is treated as a usable login, leaving the container logged out"
}

# The token authenticates Claude Code only; the other two CLIs have their own credentials.
function test_claude_oauth_token_is_not_forwarded_to_other_flavors() {
  local case_home="${TEST_ROOT}/oauth-other-flavor-home"
  local run_args="${case_home}/run-args"

  mkdir -p "${case_home}/.gemini"

  ( cd "${case_home}" && env -i \
    PATH="${STUB_PATH}:${ORIGINAL_PATH}" \
    HOME="${case_home}" \
    CLAUDE_CODE_OAUTH_TOKEN="test-oauth-cross-flavor-sentinel" \
    TEST_DOCKER_RUN_ARGS_FILE="${run_args}" \
    "${BIN_ROOT}/gemini-container" )

  if grep --fixed-strings --line-regexp --quiet -- 'CLAUDE_CODE_OAUTH_TOKEN' "${run_args}"; then
    fail "the Claude OAuth token is forwarded to the gemini flavor"
  fi
  if grep --fixed-strings --quiet -- 'test-oauth-cross-flavor-sentinel' "${run_args}"; then
    fail "the Claude OAuth token value reaches a non-claude flavor's docker run argv"
  fi
}

