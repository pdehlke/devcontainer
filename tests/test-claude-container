# The current directory and the SSH agent proxy socket are the only two unconditional mounts
# (scripts/claude-container's own comment says so); an unset or empty CONTAINER_EXTRA_MOUNTS must
# not add a third.
function test_extra_mounts_unset_adds_no_extra_volume() {
  local case_home="${TEST_ROOT}/extra-mounts-unset-home"
  local run_args_unset="${case_home}/run-args-unset"
  local run_args_empty="${case_home}/run-args-empty"

  mkdir -p "${case_home}"

  # Test unset
  ( cd "${case_home}" && env -i \
    PATH="${STUB_PATH}:${ORIGINAL_PATH}" \
    HOME="${case_home}" \
    TEST_KEYCHAIN_CLAUDE_CODE_OAUTH_TOKEN="test-oauth-token" \
    TEST_DOCKER_RUN_ARGS_FILE="${run_args_unset}" \
    "${BIN_ROOT}/claude-container" )

  local volume_count
  volume_count="$(grep --count --fixed-strings --line-regexp -- '-v' "${run_args_unset}")"
  [[ "${volume_count}" -eq 2 ]] || \
    fail "an unset CONTAINER_EXTRA_MOUNTS changes the -v flag count from the baseline of 2"

  # Test explicitly empty string (must produce identical argv to unset case)
  ( cd "${case_home}" && env -i \
    PATH="${STUB_PATH}:${ORIGINAL_PATH}" \
    HOME="${case_home}" \
    TEST_KEYCHAIN_CLAUDE_CODE_OAUTH_TOKEN="test-oauth-token" \
    CONTAINER_EXTRA_MOUNTS="" \
    TEST_DOCKER_RUN_ARGS_FILE="${run_args_empty}" \
    "${BIN_ROOT}/claude-container" )

  volume_count="$(grep --count --fixed-strings --line-regexp -- '-v' "${run_args_empty}")"
  [[ "${volume_count}" -eq 2 ]] || \
    fail "an empty CONTAINER_EXTRA_MOUNTS changes the -v flag count from the baseline of 2"
}

