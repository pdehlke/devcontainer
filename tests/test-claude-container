function test_missing_image_errors_with_build_hint() {
  local case_home="${TEST_ROOT}/missing-image-home"
  local stderr_file="${case_home}/stderr"
  local exit_code=0

  mkdir -p "${case_home}"
  if env -i \
    PATH="${STUB_PATH}:${ORIGINAL_PATH}" \
    HOME="${case_home}" \
    TEST_DOCKER_IMAGE_INSPECT_STATUS=1 \
    "${BIN_ROOT}/claude-container" >/dev/null 2>"${stderr_file}"; then
    exit_code=0
  else
    exit_code="${?}"
  fi

  (( exit_code != 0 )) || fail "launcher succeeds with no image built"
  grep --fixed-strings --quiet -- 'build.zsh' "${stderr_file}" || \
    fail "missing-image error omits the build hint"
}

function main() {
  local test_root

  test_root=$(mktemp -d "${TMPDIR:-/tmp}/devcontainer-test-claude-container.XXXXXXXX")
  typeset -g TEST_ROOT="${test_root:A}"
  chmod 0700 "${TEST_ROOT}"

  typeset -g BIN_ROOT="${TEST_ROOT}/bin"
  mkdir -p "${BIN_ROOT}"
  ln -s "${LAUNCHER}" "${BIN_ROOT}/claude-container"
  ln -s "${LAUNCHER}" "${BIN_ROOT}/codex-container"
  ln -s "${LAUNCHER}" "${BIN_ROOT}/gemini-container"

  test_default_flavor_mounts_and_forwards_ssh_agent
  print -r -- "PASS: default flavor mounts claude config and forwards the SSH agent"
  test_claude_flavor_forwards_flags_to_claude_command
  print -r -- "PASS: claude flavor forwards flags to an injected claude command"
  test_claude_oauth_token_from_env_stays_off_argv
  print -r -- "PASS: CLAUDE_CODE_OAUTH_TOKEN reaches docker without leaking onto its argv"
  test_claude_oauth_token_falls_back_to_keychain
  print -r -- "PASS: the Claude OAuth token falls back to the macOS Keychain"
  test_missing_claude_oauth_token_warns_with_setup_hint
  print -r -- "PASS: a missing Claude OAuth token warns with the setup commands"
  test_claude_oauth_token_is_not_forwarded_to_other_flavors
  print -r -- "PASS: the Claude OAuth token is not forwarded to other flavors"
  test_full_scope_credential_suppresses_the_oauth_token
  print -r -- "PASS: a full-scope credential suppresses the setup-token"
  test_empty_token_stub_does_not_suppress_the_oauth_token
  print -r -- "PASS: the empty-token stub does not suppress the setup-token"
  test_codex_flavor_injects_yolo_and_mounts_codex_config
