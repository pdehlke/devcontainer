#!/usr/bin/env bash
# claude-container: launch the devcontainer image from any repo, running Claude Code, Codex,
# or Gemini CLI depending on the name it's invoked as (see the `install` target in ../Makefile).
# Adapted from https://github.com/nicwolff/claude-container; see
# docs/superpowers/specs/2026-08-18-container-launcher-design.md for what changed and why.

set -euo pipefail

IMAGE="claude-code-dev:latest"
SELF="$(basename "$0")"
TOOL_FLAVOR="claude"

if [[ "${1:-}" == "--container-help" || "${1:-}" == "-H" ]]; then
  cat <<HELP
Usage: $SELF [ARGS...] | [COMMAND...]

Launch ${SELF%%-container} in the devcontainer image with your current directory mounted.

  claude-container                Launch Claude Code interactively
  claude-container --model opus   Pass flags to Claude Code
  codex-container                 Launch Codex CLI (--yolo added automatically)
  gemini-container                Launch Gemini CLI (--yolo added automatically)
  <any> bash                      Run an arbitrary command in the container
  <any> gh pr list                Use container tools directly
  <any> --container-help          Show this help

Environment variables (passed through when set):
  AWS_PROFILE               AWS profile to use
  AWS_REGION                AWS region for API calls
  CLAUDE_CODE_OAUTH_TOKEN   Claude Code container login from \`claude setup-token\`
                            (falls back to the macOS Keychain service of the same name)
  CLAUDE_CODE_USE_BEDROCK   Set to 1 for AWS Bedrock
  CLAUDE_GITHUB_TOKEN       GitHub personal access token for gh CLI
  GOOGLE_CLOUD_PROJECT      Google Cloud project ID for Gemini CLI Vertex usage
  GOOGLE_CLOUD_LOCATION     Google Cloud region for Gemini CLI Vertex usage
  OPENAI_API_KEY            OpenAI API key for Codex (falls back to macOS Keychain)
HELP
  exit 0
fi

# Prerequisite checks
if ! docker info >/dev/null 2>&1; then
  echo "Error: Docker is not running" >&2
  exit 1
fi
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Error: Image $IMAGE not found. Build it from the devcontainer repo:" >&2
  echo "  ./build.zsh" >&2
  exit 1
fi

# When invoked as an alternate launcher, inject the CLI command only when the user is launching
# the CLI itself rather than an arbitrary container command.
if [[ "$SELF" == "codex-container" ]]; then
  TOOL_FLAVOR="codex"
  if [ $# -eq 0 ] || [[ "${1:0:1}" == "-" ]]; then
    if [ -z "${OPENAI_API_KEY:-}" ]; then
      OPENAI_API_KEY="$(security find-generic-password -s OPENAI_API_KEY -w 2>/dev/null)" || {
        echo "Error: OPENAI_API_KEY not found in environment or macOS Keychain" >&2
        echo "  Store it with: security add-generic-password -s OPENAI_API_KEY -a openai -w 'sk-...'" >&2
        exit 1
      }
    fi
    set -- codex --yolo "$@"
  fi
elif [[ "$SELF" == "gemini-container" ]]; then
  TOOL_FLAVOR="gemini"
  if [ $# -eq 0 ] || [[ "${1:0:1}" == "-" ]]; then
    set -- gemini --yolo "$@"
  fi
else
  if [ $# -eq 0 ] || [[ "${1:0:1}" == "-" ]]; then
    set -- claude "$@"
  fi

  # Claude Code stores its OAuth credentials in the macOS Keychain on this host, but reads them
  # from ~/.claude/.credentials.json on Linux. The mounted ~/.claude therefore reaches the
  # container carrying a stub whose accessToken and refreshToken are empty strings, so a container
  # session knows the account -- that comes from ~/.claude.json's oauthAccount, which is complete
  # -- while having no usable token, and fails with "OAuth session expired and could not be
  # refreshed". The Keychain is not a file, so no additional mount can close this gap: the
  # container needs a credential of its own. CLAUDE_CODE_OAUTH_TOKEN, from `claude setup-token`,
  # outranks the on-disk credential in Claude Code's authentication precedence, so it bypasses the
  # unusable stub rather than having to replace it.
  #
  # Reading it from the Keychain rather than the shell profile is deliberate. Claude Code deletes
  # the "Claude Code-credentials" Keychain entry on exit when CLAUDE_CODE_OAUTH_TOKEN is set
  # (anthropics/claude-code#37512), so exporting this variable in ~/.zshrc would log the *host*
  # out. Set here, it reaches only the container. FORWARD_CLAUDE_OAUTH_TOKEN, rather than the
  # variable's own presence, gates the -e below: this credential authenticates Claude Code alone,
  # and codex and gemini launches must not receive it just because the caller's shell has it set.
  if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    CLAUDE_CODE_OAUTH_TOKEN="$(security find-generic-password -s CLAUDE_CODE_OAUTH_TOKEN -w 2>/dev/null)" || true
  fi
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    export CLAUDE_CODE_OAUTH_TOKEN
    FORWARD_CLAUDE_OAUTH_TOKEN=1
  elif [ "${1:-}" = "claude" ]; then
    cat >&2 <<'NOTOKEN'
Warning: no CLAUDE_CODE_OAUTH_TOKEN found; Claude Code will start logged out.
  The host's login lives in the macOS Keychain, which cannot be mounted into a Linux
  container, so the mounted ~/.claude carries an empty-token stub. Mint a container
  credential once (it lasts a year), then store it for every future launch:
    claude setup-token
    security add-generic-password -s CLAUDE_CODE_OAUTH_TOKEN -a "$USER" -w
  Do not export CLAUDE_CODE_OAUTH_TOKEN in your shell profile: Claude Code deletes the
  host's Keychain login on exit when that variable is set.
NOTOKEN
  fi
fi

# Get absolute path of current directory
PWD_ABS="$(pwd)"

# Build volume mounts; skip optional paths that don't exist on the host. The current directory
# and the SSH agent proxy socket are not optional.
VOLUMES=(
  -v "${PWD_ABS}:${PWD_ABS}"
  -v "/run/host-services/ssh-auth.sock:/run/host-services/ssh-auth.sock"
)
if [ -f "${HOME}/.gitconfig" ]; then
  VOLUMES+=(-v "${HOME}/.gitconfig:/home/pde/.gitconfig:ro")
else
  echo "Warning: ~/.gitconfig not found; git identity will be unavailable in the container" >&2
fi
[ -d "${HOME}/.aws" ] && VOLUMES+=(-v "${HOME}/.aws:/home/pde/.aws:ro")
[ -d "${HOME}/.config/gh" ] && VOLUMES+=(-v "${HOME}/.config/gh:/home/pde/.config/gh:ro")

if [ "$TOOL_FLAVOR" = "codex" ]; then
  [ -d "${HOME}/.codex" ] && VOLUMES+=(-v "${HOME}/.codex:/home/pde/.codex:rw")
elif [ "$TOOL_FLAVOR" = "gemini" ]; then
  [ -d "${HOME}/.gemini" ] && VOLUMES+=(-v "${HOME}/.gemini:/home/pde/.gemini:rw")
  [ -d "${HOME}/.config/gcloud" ] && VOLUMES+=(-v "${HOME}/.config/gcloud:/home/pde/.config/gcloud:rw")
else
  [ -d "${HOME}/.claude" ] && VOLUMES+=(-v "${HOME}/.claude:/home/pde/.claude:rw")
  [ -f "${HOME}/.claude.json" ] && VOLUMES+=(-v "${HOME}/.claude.json:/home/pde/.claude.json:rw")
fi

# Keep secrets off the docker run process argv, which stays visible via ps for the container's
# entire lifetime (this script execs docker run, so it never exits until the container does).
# Export the values instead and pass docker a bare -e VARNAME; docker reads the value from its
# own process environment when no "=value" is given.
#
# Forwarding GITHUB_TOKEN is gated on CLAUDE_GITHUB_TOKEN specifically, not on GITHUB_TOKEN's own
# ambient presence: GITHUB_TOKEN is a common env var name (gh itself, Terraform's GitHub
# provider, GitHub Actions convention), and this script must not forward a value that happens to
# already be set for some unrelated reason. CLAUDE_GITHUB_TOKEN is the only documented, explicit
# opt-in for this.
if [ -n "${CLAUDE_GITHUB_TOKEN:-}" ]; then
  export GITHUB_TOKEN="${CLAUDE_GITHUB_TOKEN}"
  FORWARD_GITHUB_TOKEN=1
fi
if [ -n "${OPENAI_API_KEY:-}" ]; then
  export OPENAI_API_KEY
fi

# Only allocate a pty when one is actually available, so non-interactive invocations (piped or
# redirected, e.g. `<any> gh pr list > out.txt`) work instead of failing or emitting pty CRLFs.
TTY_FLAGS=(-i)
[ -t 0 ] && [ -t 1 ] && TTY_FLAGS+=(-t)

# Run the dev container. SSH_AUTH_SOCK points at the in-image symlink the Dockerfile creates
# to /run/host-services/ssh-auth.sock, matching compose.yaml's forwarding setup.
exec docker run --rm "${TTY_FLAGS[@]}" \
  "${VOLUMES[@]}" -w "${PWD_ABS}" \
  -e "SSH_AUTH_SOCK=/home/pde/.1password/agent.sock" \
  ${AWS_PROFILE:+-e "AWS_PROFILE=${AWS_PROFILE}"} \
  ${AWS_REGION:+-e "AWS_REGION=${AWS_REGION}"} \
  ${FORWARD_CLAUDE_OAUTH_TOKEN:+-e CLAUDE_CODE_OAUTH_TOKEN} \
  ${CLAUDE_CODE_USE_BEDROCK:+-e "CLAUDE_CODE_USE_BEDROCK=${CLAUDE_CODE_USE_BEDROCK}"} \
  ${FORWARD_GITHUB_TOKEN:+-e GITHUB_TOKEN} \
  ${GOOGLE_CLOUD_PROJECT:+-e "GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT}"} \
  ${GOOGLE_CLOUD_LOCATION:+-e "GOOGLE_CLOUD_LOCATION=${GOOGLE_CLOUD_LOCATION}"} \
  ${OPENAI_API_KEY:+-e OPENAI_API_KEY} \
  "$IMAGE" "$@"
